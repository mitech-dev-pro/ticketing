// miLife Service Desk — data model.
// Phase 1 adds User, Session, AuthToken, Department, ServiceType, Holiday, Setting.
// Phase 2 adds Ticket, TicketLeg, TicketEvent, TicketMention (see BUILD_PLAN.md).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  MEMBER
  HEAD
  ADMIN
}

enum Branch {
  ACHIMOTA_HQ
  KUMASI
  TAKORADI
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum AuthTokenType {
  INVITE
  RESET
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_REQUESTER
  RESOLVED
  CLOSED
}

enum Channel {
  PORTAL
  EMAIL
  TEAMS
}

// MESSAGE/NOTE/ASSIGNED/FORWARDED/PRIORITY_CHANGED/STATUS_CHANGED/RESOLVED/
// CONFIDENTIAL_CHANGED/REOPENED/RATED/RATING_FOLLOWED_UP are written by Phase 2/3
// services. ESCALATED, BLOCKED_BY, BLOCKS, RELATED_TO only appear in seeded history
// until their owning phase (escalation/merge) implements the behaviour.
enum TicketEventType {
  CREATED
  MESSAGE
  NOTE
  ASSIGNED
  FORWARDED
  PRIORITY_CHANGED
  STATUS_CHANGED
  RESOLVED
  CONFIDENTIAL_CHANGED
  REOPENED
  ESCALATED
  RATED
  RATING_FOLLOWED_UP
  BLOCKED_BY
  BLOCKS
  RELATED_TO
}

enum MentionType {
  PERSON
  DEPARTMENT
}

// Fed by the cron jobs in app/api/cron/* (Phase 4): sla-warning writes SLA_WARNING /
// FIRST_RESPONSE_MISS, escalate writes ESCALATED_L1 / ESCALATED_L2.
enum NotificationKind {
  SLA_WARNING
  FIRST_RESPONSE_MISS
  ESCALATED_L1
  ESCALATED_L2
}

model Department {
  id                    String          @id @default(cuid())
  slug                  String          @unique
  name                  String
  hue                   Int
  emailAlias            String          @unique
  confidentialByDefault Boolean         @default(false)
  headUserId            String?         @unique
  head                  User?           @relation("DepartmentHead", fields: [headUserId], references: [id])
  members               User[]          @relation("DepartmentMembers")
  serviceTypes          ServiceType[]
  ticketsRequested      Ticket[]        @relation("TicketRequesterDepartment")
  ticketLegs            TicketLeg[]
  ticketMentions        TicketMention[] @relation("TicketMentionDepartment")
  cannedReplies         CannedReply[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model User {
  id                  String          @id @default(cuid())
  name                String
  email               String          @unique
  passwordHash        String
  role                Role
  departmentId        String
  department          Department      @relation("DepartmentMembers", fields: [departmentId], references: [id])
  branch              Branch
  active              Boolean         @default(true)
  failedLoginCount    Int             @default(0)
  lockedUntil         DateTime?
  phone               String?
  ext                 String?
  signature           String?         @db.Text
  theme               String?
  density             String?
  notificationPrefs   Json?
  headOfDepartment    Department?     @relation("DepartmentHead")
  sessions            Session[]
  authTokens          AuthToken[]
  ticketsRequested    Ticket[]        @relation("TicketRequester")
  ticketsAssigned     Ticket[]        @relation("TicketAssignee")
  ticketLegs          TicketLeg[]     @relation("TicketLegBy")
  ticketEvents        TicketEvent[]   @relation("TicketEventBy")
  ticketMentions      TicketMention[] @relation("TicketMentionUser")
  attachmentsUploaded Attachment[]    @relation("AttachmentUploadedBy")
  escalationsRaised   Escalation[]    @relation("EscalationBy")
  escalationsAcked    Escalation[]    @relation("EscalationAcknowledgedBy")
  notifications       Notification[]
  outOfOffice         OutOfOffice[]   @relation("OutOfOfficeUser")
  outOfOfficeDelegate OutOfOffice[]   @relation("OutOfOfficeDelegate")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuthToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
}

model ServiceType {
  id                 String     @id @default(cuid())
  departmentId       String
  department         Department @relation(fields: [departmentId], references: [id])
  name               String
  description        String     @db.Text
  defaultPriority    Priority
  needsApproval      Boolean    @default(false)
  attachmentRequired Boolean    @default(false)
  fields             Json
  tickets            Ticket[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

// Ticket.number starts at 24827 (D-12): the migration this model ships in ends with
// `ALTER TABLE Ticket AUTO_INCREMENT = 24827;`, added by hand since Prisma cannot
// express a start value. Seed tickets keep their prototype numbers (24788–24826).
model Ticket {
  number                Int             @id @default(autoincrement())
  subject               String
  description           String          @db.Text
  fields                Json
  requesterId           String
  requester             User            @relation("TicketRequester", fields: [requesterId], references: [id])
  requesterDepartmentId String
  requesterDepartment   Department      @relation("TicketRequesterDepartment", fields: [requesterDepartmentId], references: [id])
  serviceTypeId         String
  serviceType           ServiceType     @relation(fields: [serviceTypeId], references: [id])
  assigneeId            String?
  assignee              User?           @relation("TicketAssignee", fields: [assigneeId], references: [id])
  priority              Priority
  status                TicketStatus    @default(OPEN)
  channel               Channel         @default(PORTAL)
  confidential          Boolean         @default(false)
  // D-02/D-03: createdAt + target + pausedMs on the ticket's calendar.
  dueAt                 DateTime
  firstResponseDueAt    DateTime
  firstResponseAt       DateTime?
  resolvedAt            DateTime?
  pausedAt              DateTime?
  pausedMs              Int             @default(0)
  // Set by rate() (requester, 1-5 stars) once resolved; ratingFollowedUpAt is set by
  // markRatingFollowedUp() (head/admin) dismissing the low-rating banner for a 1-2 star csat.
  csat                  Int?
  ratingFollowedUpAt    DateTime?
  legs                  TicketLeg[]
  events                TicketEvent[]
  mentions              TicketMention[]
  attachments           Attachment[]
  escalations           Escalation[]
  notifications         Notification[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([requesterDepartmentId])
  @@index([confidential])
}

// The ticket's journey. The leg with outAt = null is its current department
// (`currentDepartmentId` in lib/permissions.ts); every other leg is a department it
// passed through, which keeps read-only access after a forward.
model TicketLeg {
  id           String     @id @default(cuid())
  ticketId     Int
  ticket       Ticket     @relation(fields: [ticketId], references: [number], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  byUserId     String
  by           User       @relation("TicketLegBy", fields: [byUserId], references: [id])
  reason       String?    @db.Text
  inAt         DateTime   @default(now())
  outAt        DateTime?

  @@index([ticketId])
  @@index([departmentId, outAt])
}

// Append-only (CLAUDE.md): every ticket change writes one of these in the same
// transaction. Never updated or deleted.
model TicketEvent {
  id          String          @id @default(cuid())
  ticketId    Int
  ticket      Ticket          @relation(fields: [ticketId], references: [number], onDelete: Cascade)
  type        TicketEventType
  byUserId    String?
  by          User?           @relation("TicketEventBy", fields: [byUserId], references: [id])
  body        String?         @db.Text
  meta        Json?
  createdAt   DateTime        @default(now())
  attachments Attachment[]

  @@index([ticketId, createdAt])
}

// Queryable @mentions (D-05, D-07): a real table, not JSON, because
// `visibleTicketsWhere(user)` must be able to join against it. Exactly one of
// userId/departmentId is set, matching `type`; enforced by the service layer that
// writes these rows from a MESSAGE/NOTE event's mentions.
model TicketMention {
  id           String      @id @default(cuid())
  ticketId     Int
  ticket       Ticket      @relation(fields: [ticketId], references: [number], onDelete: Cascade)
  type         MentionType
  userId       String?
  user         User?       @relation("TicketMentionUser", fields: [userId], references: [id])
  departmentId String?
  department   Department? @relation("TicketMentionDepartment", fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([ticketId])
  @@index([userId])
  @@index([departmentId])
}

// Files on a reply or note (Phase 3). Denormalizes ticketId alongside the owning
// eventId so a visibility check can filter on the ticket without joining through
// TicketEvent; lib/storage.ts resolves storageKey to actual bytes (Vercel Blob or,
// in local dev without a token, the filesystem).
model Attachment {
  id           String      @id @default(cuid())
  ticketId     Int
  ticket       Ticket      @relation(fields: [ticketId], references: [number], onDelete: Cascade)
  eventId      String
  event        TicketEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User        @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
  filename     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  createdAt    DateTime    @default(now())

  @@index([ticketId])
  @@index([eventId])
}

// Department-scoped composer shortcuts (D-13: seeded from the prototype's CANNED
// data via prisma/seed-data/canned-replies.json). departmentId null means a global
// reply offered in every department's composer. Admin CRUD for these is Phase 8
// scope; Phase 3 only reads them into the composer.
model CannedReply {
  id           String      @id @default(cuid())
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  title        String
  body         String      @db.Text
  createdAt    DateTime    @default(now())

  @@unique([departmentId, title])
}

// Breach escalations (Phase 4). The unique (ticketId, level) constraint is what keeps
// the cron job (app/api/cron/escalate) and a human's manual escalate() (D-15) from
// ever double-escalating the same ticket to the same level. byUserId is set for a
// manual escalation and null for one the cron raised.
model Escalation {
  id               String    @id @default(cuid())
  ticketId         Int
  ticket           Ticket    @relation(fields: [ticketId], references: [number], onDelete: Cascade)
  level            Int
  reason           String?   @db.Text
  byUserId         String?
  by               User?     @relation("EscalationBy", fields: [byUserId], references: [id])
  at               DateTime  @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?     @relation("EscalationAcknowledgedBy", fields: [acknowledgedById], references: [id])

  @@unique([ticketId, level])
  @@index([ticketId])
}

// Feeds the header dropdown and the 07:30 digest (Phase 4). A unique (userId,
// ticketId, kind) means a cron re-run or a doubled notify can't duplicate the same
// notification — one SLA_WARNING per user per ticket, ever.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketId  Int
  ticket    Ticket           @relation(fields: [ticketId], references: [number], onDelete: Cascade)
  kind      NotificationKind
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, ticketId, kind])
  @@index([userId, readAt])
  @@index([ticketId])
}

// The Profile & settings toggle to create these is Phase 7; Phase 4 only needs the
// model and the cron (app/api/cron/out-of-office) that reassigns the user's open
// tickets to delegateUserId. Reassignment is naturally idempotent: once a ticket's
// assigneeId is the delegate, the cron's own WHERE clause no longer matches it.
model OutOfOffice {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation("OutOfOfficeUser", fields: [userId], references: [id], onDelete: Cascade)
  delegateUserId String
  delegate       User     @relation("OutOfOfficeDelegate", fields: [delegateUserId], references: [id])
  until          DateTime
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([until])
}
