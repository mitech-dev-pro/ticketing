# Copy to .env (and .env.test with DATABASE_URL pointing at milife_test).
# See scripts/setup-mysql-local.sql to create the local databases and app user.

NODE_ENV=development
APP_URL="http://localhost:3000"
DATABASE_URL="mysql://milife_app:CHANGE_ME@localhost:3306/milife_dev"
SHADOW_DATABASE_URL="mysql://milife_app:CHANGE_ME@localhost:3306/milife_shadow"
SEED_PASSWORD="change-me-dev-only-password"
# Leave unset in development: lib/email.ts logs emails to the console instead.
RESEND_API_KEY=
